# Generates the coop build ID that the handshake compares (see Coop::BuildVersion).
#
# Run on every build through the CoopBuildId target:
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<file.c> -DCONFIG=<Release|Debug> -P CoopBuildId.cmake
#
# ID = <git commit, 10 chars>[+<8 hex of a hash of uncommitted changes>]-<config>, e.g. "fb9c950d5c-Release" or
# "fb9c950d5c+3f2a91c0-Release". Any change to the sources, committed or not, changes the ID, so two binaries
# built from different code never pass the check. The file is only rewritten when the ID changes, so a build with
# no changes does not recompile or relink.

execute_process(
    COMMAND git rev-parse --short=10 HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE COOP_GIT_HEAD
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE COOP_GIT_RESULT
    ERROR_QUIET
)

if(NOT COOP_GIT_RESULT EQUAL 0 OR COOP_GIT_HEAD STREQUAL "")
    set(COOP_BUILD_ID "nogit")
else()
    set(COOP_BUILD_ID "${COOP_GIT_HEAD}")

    # Tracked changes, including inside submodules such as libultraship.
    execute_process(
        COMMAND git diff HEAD --binary --submodule=diff
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE COOP_GIT_DIFF
        ERROR_QUIET
    )
    # New files that are not ignored (the build globs pick them up too).
    execute_process(
        COMMAND git ls-files --others --exclude-standard
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE COOP_GIT_UNTRACKED
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    set(COOP_DIRTY_STATE "${COOP_GIT_DIFF}")
    if(NOT COOP_GIT_UNTRACKED STREQUAL "")
        string(REPLACE "\n" ";" COOP_UNTRACKED_LIST "${COOP_GIT_UNTRACKED}")
        foreach(COOP_FILE IN LISTS COOP_UNTRACKED_LIST)
            if(EXISTS "${SOURCE_DIR}/${COOP_FILE}" AND NOT IS_DIRECTORY "${SOURCE_DIR}/${COOP_FILE}")
                file(SHA256 "${SOURCE_DIR}/${COOP_FILE}" COOP_FILE_HASH)
                string(APPEND COOP_DIRTY_STATE "\n${COOP_FILE}:${COOP_FILE_HASH}")
            endif()
        endforeach()
    endif()

    if(NOT COOP_DIRTY_STATE STREQUAL "")
        string(SHA256 COOP_DIRTY_HASH "${COOP_DIRTY_STATE}")
        string(SUBSTRING "${COOP_DIRTY_HASH}" 0 8 COOP_DIRTY_HASH)
        string(APPEND COOP_BUILD_ID "+${COOP_DIRTY_HASH}")
    endif()
endif()

string(APPEND COOP_BUILD_ID "-${CONFIG}")

set(COOP_CONTENT "// Generated by mm/2s2h/Coop/CoopBuildId.cmake on every build. Do not edit.\n")
string(APPEND COOP_CONTENT "const char gCoopBuildId[] = \"${COOP_BUILD_ID}\";\n")

set(COOP_PREVIOUS "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" COOP_PREVIOUS)
endif()
if(NOT COOP_PREVIOUS STREQUAL COOP_CONTENT)
    file(WRITE "${OUTPUT}" "${COOP_CONTENT}")
    message(STATUS "Coop build ID: ${COOP_BUILD_ID}")
endif()
